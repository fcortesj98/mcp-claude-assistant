# Required for the Claude-powered features (Generate Documentation, Review Code, Converse)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional client overrides
# CLAUDE_MODEL=claude-sonnet-5
# CLAUDE_MAX_TOKENS=4096
# CLAUDE_MAX_TOOL_ROUNDS=10

# Optional server overrides
# MCP_BASE_DIR=/path/to/sandbox        # defaults to the current working directory
# MCP_SERVER_NAME=File Operations MCP Server
# MCP_WRITE_PROGRESS_STEPS=10
# MCP_WRITE_PROGRESS_DELAY=0.05
